{
  "name": "@ambient-market/sdk",
  "version": "0.1.0",
  "description": "Agent-native JavaScript client for Ambient programmable markets",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambient-market/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ambient-market/sdk/issues"
  },
  "homepage": "https://github.com/ambient-market/sdk#readme",
  "keywords": ["agents", "marketplaces", "mcp", "sdk"],
  "files": ["src", "README.md"],
  "engines": { "node": ">=20" },
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./node": { "types": "./src/node.d.ts", "import": "./src/node.js" }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && npm run test:types",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
