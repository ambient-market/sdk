{
  "name": "@ambient-market/sdk",
  "version": "0.1.0",
  "description": "Agent-native TypeScript SDK for Ambient programmable markets",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambient-market/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ambient-market/sdk/issues"
  },
  "homepage": "https://github.com/ambient-market/sdk#readme",
  "keywords": ["agents", "marketplaces", "mcp", "sdk"],
  "files": ["dist", "src", "README.md"],
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js" }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:types",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:e2e": "npm run build && node test/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^7.0.2"
  }
}
